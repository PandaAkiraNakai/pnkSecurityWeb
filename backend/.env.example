# Copia este archivo a .env para desarrollo local. Nunca subas .env al repositorio.
PORT=3000
# En local solo este equipo; en AWS 0.0.0.0 (el grupo de seguridad deja entrar solo al ALB)
HOST=127.0.0.1
# Cuenta de la API (permisos mínimos)
DATABASE_URL=postgres://pnk_app:dev-solo-local-app@127.0.0.1:55432/pnk
# Cuenta dueña del esquema: solo la usa "npm run migrar"
DATABASE_URL_MIGRACION=postgres://pnk_owner:dev-solo-local-owner@127.0.0.1:55432/pnk
# Clave para firmar la sesión: mínimo 32 caracteres aleatorios (openssl rand -base64 48)
JWT_SECRET=cambia-esta-clave-por-una-aleatoria-de-32-o-mas
# En AWS va detrás del ALB con HTTPS: true. En local por http: false
COOKIE_SECURE=false
# Solo si la API está detrás de un balanceador (AWS): número de proxies de confianza
TRUST_PROXY=0
