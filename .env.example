# Copiar a .env y reemplazar los valores. El archivo .env NO se versiona.
DB_NAME=pnk_security
DB_USER=pnk_app
DB_PASSWORD=cambiar-esta-clave
DB_ROOT_PASSWORD=cambiar-esta-clave-root
# ES3: cuenta de administración para phpMyAdmin (solo DML sobre la base). Sin comillas.
DB_ADMIN_USER=pnk_admin
DB_ADMIN_PASSWORD=cambiar-esta-clave-admin
